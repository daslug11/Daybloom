{
  "name": "daybloom",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/flows.mjs",
    "supabase:up": "node scripts/local-supabase.mjs up",
    "supabase:migrate": "node scripts/local-supabase.mjs migrate",
    "supabase:reset": "node scripts/local-supabase.mjs reset",
    "supabase:down": "node scripts/local-supabase.mjs down",
    "gateway": "node scripts/local-gateway.mjs",
    "mock:ai": "node tests/mock/anthropic.mjs 4010"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "canvas-confetti": "^1.9.4",
    "chrono-node": "^2.10.3",
    "framer-motion": "^14.7.1",
    "lucide-react": "^1.63.0",
    "node-ical": "^0.27.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "5.6",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  }
}
