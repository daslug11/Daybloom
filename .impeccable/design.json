  "narrative": {
    "northStar": "The Clear Head",
    "overview": "Daybloom exists to get thoughts out of a student's head and into a clear, sorted place. The interface is crisp, precise and quick, with tactile, confident surfaces. Dark-first on an untinted near-black with a complete light theme; emphasis is ink (near-white in dark, near-black in light); colour appears only for meaning (priority, status, calendar identity) and cyan only for Atlas. The voice HUD is the one showpiece.",
    "keyCharacteristics": [
      "Dark-first, light theme complete; every text role passes WCAG AA on every surface.",
      "One sans family (Inter); system monospace for keyboard hints and the HUD.",
      "Solid surfaces with shallow shadows; no blur, gradients or glows.",
      "Colour reserved for meaning: priority, status, calendar identity and Atlas."
    ],
    "rules": [
      {
        "name": "The Atlas Colour Rule",
        "body": "Cyan appears only where Atlas or AI is present. Manual repeating blocks, the time chip and type badges are neutral.",
        "section": "colors"
      },
      {
        "name": "The Meaning-Only Rule",
        "body": "Outside the voice HUD, colour must mean something: priority, status, calendar identity or Atlas. Decorative colour is removed.",
        "section": "colors"
      },
      {
        "name": "The No-Ornament Type Rule",
        "body": "Headings are solid colour. Hierarchy comes from size and weight, never gradients, and labels are never uppercase-tracked.",
        "section": "typography"
      }
    ],
    "dos": [
      "Use semantic roles (bg-surface, text-muted, border-line), never raw palette classes.",
      "Keep dark as the default and the light theme complete; check contrast in both.",
      "Use cyan only for Atlas and AI.",
      "Register any new overlay with useOverlay.",
      "Respect prefers-reduced-motion."
    ],
    "donts": [
      "Don't use gradient text, gradient buttons, coloured glows or backdrop blur in the everyday UI.",
      "Don't add violet or any other brand hue; emphasis is ink.",
      "Don't tint the dark background.",
      "Don't use text smaller than 12px or uppercase-tracked labels.",
      "Don't invent numbers, testimonials or insights."
    ]
  }
