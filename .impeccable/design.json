  "narrative": {
    "northStar": "The Clear Head",
    "overview": "Daybloom exists to get thoughts out of a student's head and into a clear, sorted place. The interface should feel like that moment: nothing competing for attention, the next action obvious, everything else quiet. The confirmed character is crisp, precise and quick, and surfaces should feel tactile and confident. Today's implementation is dark-first glass over a violet-tinted near-black; the confirmed direction moves emphasis to neutral near-white, reserves cyan for Atlas, uses a neutral near-black, and keeps the voice HUD as the one showpiece.",
    "keyCharacteristics": [
      "Dark-first, with a complete light theme.",
      "One sans family (Inter) for everything outside the HUD; monospace only in the HUD.",
      "Dense, card-based app screens (Operate mode); a marketing landing page (Persuade mode).",
      "Colour reserved for meaning: priority, status, calendar identity and Atlas."
    ],
    "rules": [
      {
        "name": "The Atlas Colour Rule",
        "body": "Cyan appears only where Atlas or AI is present. Anything else that is cyan today (including manual repeating blocks) is a bug to fix.",
        "section": "colors"
      },
      {
        "name": "The Meaning-Only Rule",
        "body": "Outside the voice HUD, colour must mean something: priority, status, calendar identity or Atlas. Decorative colour is removed.",
        "section": "colors"
      },
      {
        "name": "The No-Ornament Type Rule",
        "body": "Headings are solid colour. Hierarchy comes from size and weight, never gradients. (Today: 77 gradient-text findings per theme.)",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep the dark theme as the default and keep the light theme complete.",
      "Do keep every page's header as title + one plain sentence saying what the page is for.",
      "Do use cyan only for Atlas and AI (The Atlas Colour Rule).",
      "Do respect prefers-reduced-motion: the global rule in index.css reduces all motion to 0.01ms.",
      "Do keep the voice HUD as the single bold surface."
    ],
    "donts": [
      "Don't use gradient text, gradient buttons or coloured glows in the everyday UI (confirmed direction).",
      "Don't add violet or purple emphasis; emphasis moves to neutral near-white (confirmed direction).",
      "Don't tint the dark background or add background glows (confirmed direction).",
      "Don't use 10px text for anything a user needs to read.",
      "Don't invent numbers, testimonials or \"insights\" in any design (PRODUCT.md commitment)."
    ]
  }
